exp::parse_one(f, s, i, prec, prev) {
    let op;

    const asm = raw::parse(f, s, i, prec, prev);
    if asm.msg != void | asm.res != void: return asm;
    const str = exp::string::parse(f, s, i, prec, prev);
    if str.msg != void | str.res != void: return str;
    const char = exp::char::parse(f, s, i, prec, prev);
    if char.msg != void | char.res != void: return char;
    const int = exp::int::parse(f, s, i, prec, prev);
    if int.msg != void | int.res != void: return int;

    op = exp::pre_op::parse(f, s, i, prec, prev, "+", 30);
    if op.msg != void | op.res != void: return op;
    op = exp::pre_op::parse(f, s, i, prec, prev, "-", 30);
    if op.msg != void | op.res != void: return op;

    const parens = exp::parens::parse(f, s, i, prec, prev);
    if parens.msg != void | parens.res != void: return parens;

    const var = exp::var::parse(f, s, i, prec, prev);
    if var.msg != void | var.res != void: return var;

    const call = exp::call::parse(f, s, i, prec, prev);
    if call.msg != void | call.res != void: return call;
    const member = exp::member::parse(f, s, i, prec, prev);
    if member.msg != void | member.res != void: return member;

    op = exp::bin_op::parse(f, s, i, prec, prev, "+", 10);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, "-", 10);
    if op.msg != void | op.res != void: return op;

    op = exp::bin_op::parse(f, s, i, prec, prev, "*", 11);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, "/", 11);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, "%", 11);
    if op.msg != void | op.res != void: return op;

    op = exp::bin_op::parse(f, s, i, prec, prev, "<=", 5);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, ">=", 5);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, "<", 5);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, ">", 5);
    if op.msg != void | op.res != void: return op;

    op = exp::bin_op::parse(f, s, i, prec, prev, "==", 4);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, "!=", 4);
    if op.msg != void | op.res != void: return op;

    op = exp::bin_op::parse(f, s, i, prec, prev, "&", 3);
    if op.msg != void | op.res != void: return op;
    op = exp::bin_op::parse(f, s, i, prec, prev, "|", 2);
    if op.msg != void | op.res != void: return op;

    let assign;

    assign = exp::assign::parse(f, s, i, prec, prev, "");
    if assign.msg != void | assign.res != void: return assign;

    return parse_res::fail;
}

exp::parse(f, s, i, prec, _prev) {
    let n = 0;
    let prev = _prev;

    do {
        const res = exp::parse_one(f, s, i + n, prec, prev);
        if res.msg != void: return res;
        else if res.res == void: return parse_res::val(prev, n);

        n = n + res.n;
        prev = res.res;
    }
}

exp::parse_hex(s, i, max) {
    let n = 0;
    let res = 0;

    do {
        const c = str::at(s, i + n);

        let digit = void;

        if c >= 'a' & c <= 'z': digit = c - 'a' + 10;
        else if c >= 'A' & c <= 'Z': digit = c - 'A' + 10;
        else if c >= '0' & c <= '9': digit = c - '0';
    }
    while (max == void | n < max) & digit != void {
        res = res * 16 + digit;
        n = n + 1;
    }

    if n == 0: return parse_res::fail;
    else: return parse_res::val(res, n);
}
exp::parse_oct(s, i, max) {
    let n = 0;
    let res = 0;

    do {
        const c = str::at(s, i + n);

        let digit = void;

        if c >= '0' & c <= '9': digit = c - '0';
    }
    while (max == void | n < max) & digit != void {
        if digit > 7: return parse_res::err("Expected an octal digit", i + n);
        res = res * 8 + digit;
        n = n + 1;
    }

    if n == 0: return parse_res::fail;
    else: return parse_res::val(res, n);
}
exp::parse_bin(s, i, max) {
    let n = 0;
    let res = 0;

    do {
        const c = str::at(s, i + n);

        let digit = void;

        if c >= '0' & c <= '9': digit = c - '0';
    }
    while (max == void | n < max) & digit != void {
        if digit > 1: return parse_res::err("Expected a binary digit", i + n);
        res = res * 2 + digit;
        n = n + 1;
    }

    if n == 0: return parse_res::fail;
    else: return parse_res::val(res, n);
}
exp::parse_dec(s, i, max) {
    let n = 0;
    let res = 0;

    do {
        const c = str::at(s, i + n);

        let digit = void;

        if c >= '0' & c <= '9': digit = c - '0';
    }
    while (max == void | n < max) & digit != void {
        res = res * 10 + digit;
        n = n + 1;
    }

    if n == 0: return parse_res::fail;
    else: return parse_res::val(res, n);
}

exp::parse_char(s, i) {
    let c = str::at(s, i);

    if c == '\\' {
        let n = 1;
        c = str::at(s, i + n);

        if c == 't': return parse_res::val('\t', 2);
        if c == 'n': return parse_res::val('\n', 2);
        if c == 'v': return parse_res::val('\v', 2);
        if c == 'f': return parse_res::val('\f', 2);
        if c == 'r': return parse_res::val('\r', 2);
        if c == 'e': return parse_res::val('\e', 2);
        if c == 'x' {
            n = n + 1;
            const res = exp::parse_hex(s, i + n, 4);
            if res.res == void: return parse_res::err("Expected a hex number", i + n, res);
            return parse_res::val(res.res, n + res.n);
        }
        if c == '0' {
            const res = exp::parse_oct(s, i + n, 7);
            if res.res == void: return parse_res::err("Expected an octal number", i + n, res);
            return parse_res::val(and(res.res, 65535), n + res.n);
        }
        if c == 'b' {
            const res = exp::parse_oct(s, i + n, 16);
            if res.res == void: return parse_res::err("Expected a binary number", i + n, res);
            return parse_res::val(res.res, n + res.n);
        }

        return parse_res::val(c, 2);
    }
    else: return parse_res::val(c, 1);
}

raw(loc, raw) {
    const res = node("raw", loc);
    res.data = raw;
    return res;
}
raw::parse(f, s, i, prec, prev) {
    if prev != void: return parse_res::fail;
    let n = skip_white(s, i);
    const loc = i + n;

    const name = parse_identifier(s, i + n);
    if name.res == void: return name;
    if name.res != "asm::js": return parse_res::fail;
    n = n + name.n;

    const str = exp::string::parse(f, s, i + n);
    if str.res == void: return str;
    n = n + str.n;

    let res = "";
    let j = 0;

    while j < arr::len(str.res.data) {
        res = res + char::to_string(arr::at(str.res.data, j));
        j = j + 1;
    }

    return parse_res::val(raw(to_loc(s, loc, f), res), n);
}

exp::var(loc, name) {
    const res = node("exp::var", loc);
    res.name = name;
    return res;
}
exp::var::parse(f, s, i, prec, prev) {
    if prev != void: return parse_res::fail;
    let n = skip_white(s, i);
    const loc = i + n;

    const name = parse_identifier(s, i + n);
    if name.res == void: return name;
    n = n + name.n;

    return parse_res::val(exp::var(to_loc(s, loc, f), name.res), n);
}

exp::call(loc, obj, args) {
    const res = node("exp::call", loc);
    res.obj = obj;
    res.args = args;
    return res;
}
exp::call::parse(f, s, i, prec, prev) {
    if prec > 39: return parse_res::fail;
    let n = skip_white(s, i);
    const loc = i + n;

    if prev == void {
        const res = exp::parse(f, s, i + n, 40);
        if res.res == void: return res;
        n = n + res.n;
        prev = res.res;
    }

    const args = arr();

    const open = parse_keyword(s, i + n, "(");
    if open.res == void: return open;
    n = n + open.n;

    const close = parse_keyword(s, i + n, ")");
    n = n + close.n;
    if close.res == void: do {
        const arg = exp::parse(f, s, i + n);
        if arg.res == void: return parse_res::err("Expected an argument", i + n, arg);
        n = n + arg.n;
        arr::append(args, arg.res);

        const delim = parse_keyword(s, i + n, ",");
        n = n + delim.n;
        const close = parse_keyword(s, i + n, ")");
        n = n + close.n;

        if delim.res == void & close.res == void: return parse_res::err("Expected a comma or a closing paren", i + n);
    }
    while (close.res == void);

    return parse_res::val(exp::call(to_loc(s, loc, f), prev, args), n);
}

exp::member(loc, obj, name) {
    const res = node("exp::member", loc);
    res.obj = obj;
    res.name = name;
    return res;
}
exp::member::parse(f, s, i, prec, prev) {
    if prec > 40: return parse_res::fail;
    let n = skip_white(s, i);
    const loc = i + n;

    if prev == void {
        const res = exp::parse(f, s, i + n, 41);
        if res.res == void: return res;
        n = n + res.n;
        prev = res.res;
    }

    const dot = parse_keyword(s, i + n, ".");
    if dot.res == void: return dot;
    n = n + dot.n;

    const name = parse_identifier(s, i + n);
    if name.res == void: return parse_res::err("Expected a member name", i + n, name);
    n = n + name.n;

    return parse_res::val(exp::member(to_loc(s, loc, f), prev, name), n);
}

exp::parens::parse(f, s, i, prec, prev) {
    if prev != void: return parse_res::fail;
    let n = skip_white(s, i);
    const loc = i + n;

    const open = parse_keyword(s, i + n, "(");
    if open.res == void: return open;
    n = n + open.n;

    const exp = exp::parse(f, s, i + n);
    if exp.res == void: return parse_res::err("Expected an expression", n + i, exp);
    n = n + exp.n;

    const close = parse_keyword(s, i + n, ")");
    if close.res == void: return parse_res::err("Expected closing parens", n + i, close);
    n = n + close.n;

    return parse_res::val(exp.res, n);
}

exp::assign(loc, op, obj, val) {
    const res = node("exp::assign", loc);
    res.obj = obj;
    res.val = val;
    res.op = op;
    return res;
}
exp::assign::parse(f, s, i, prec, prev, op) {
    if prev == void: return parse_res::fail;
    if prec > 1: return parse_res::fail;

    let n = skip_white(s, i);
    const loc = i + n;

    const op_res = parse_keyword(s, i + n, op + "=");
    if op_res.res == void: return op_res;
    n = n + op_res.n;

    const exp = exp::parse(f, s, i + n, 1);
    if exp.res == void: return parse_res::err("Expected an expression", n + i, exp);
    n = n + exp.n;

    if op == "": return parse_res::val(exp::assign(to_loc(s, loc, f), op, prev, exp.res), n);
    else: return parse_res::val(exp::assign(to_loc(s, loc, f), void, prev, exp.res), n);
}

exp::bin_op(loc, op, a, b) {
    const res = node("exp::bin_op", loc);
    res.op = op;
    res.a = a;
    res.b = b;
    return res;
}
exp::bin_op::parse(f, s, i, prec, prev, op, prec_op) {
    if prev == void: return parse_res::fail;
    if prec > prec_op: return parse_res::fail;

    let n = skip_white(s, i);
    const loc = i + n;

    const op_res = parse_keyword(s, i + n, op);
    if op_res.res == void: return op_res;
    n = n + op_res.n;

    const exp = exp::parse(f, s, i + n, prec_op + 1);
    if exp.res == void: return parse_res::err("Expected an expression", n + i, exp);
    n = n + exp.n;

    return parse_res::val(exp::bin_op(to_loc(s, loc, f), op, prev, exp.res), n);
}

exp::pre_op(loc, op, val) {
    const res = node("exp::pre_op", loc);
    res.op = op;
    res.val = val;
    return res;
}
exp::pre_op::parse(f, s, i, prec, prev, op, prec_op) {
    if prev != void: return parse_res::fail;
    if prec > prec_op: return parse_res::fail;

    let n = skip_white(s, i);
    const loc = i + n;

    const op_res = parse_keyword(s, i + n, op);
    if op_res.res == void: return op_res;
    n = n + op_res.n;

    const exp = exp::parse(f, s, i + n, prec_op);
    if exp.res == void: return parse_res::err("Expected an expression", n + i, exp);
    n = n + exp.n;

    return parse_res::val(exp::pre_op(to_loc(s, loc, f), op, exp.res), n);
}

exp::post_op(loc, op, val) {
    const res = node("exp::post_op", loc);
    res.op = op;
    res.val = val;
    return res;
}
exp::post_op::parse(f, s, i, prec, prev, op, prec_op) {
    if prev == void: return parse_res::fail;
    if prec > prec_op: return parse_res::fail;

    let n = skip_white(s, i);
    const loc = i + n;

    const op_res = parse_keyword(s, i + n, op);
    if op_res.res == void: return op_res;
    n = n + op_res.n;

    return parse_res::val(exp::post_op(to_loc(s, loc, f), op, exp.res), n);
}


exp::int(loc, data) {
    const res = node("exp::int", loc);
    res.data = data;
    return res;
}
exp::int::parse(f, s, i, prec, prev) {
    if prev != void: return parse_res::fail;

    let n = skip_white(s, i);
    const loc = n + i;

    if parse_keyword(s, i, "0x").n > 0 {
        n = n + 2;

        const res = exp::parse_hex(s, i + n);
        if res.res == void: return parse_res::err("Expected hex number after '0x'", i + n, res);
        else: return parse_res::val(exp::int(to_loc(s, loc, f), res.res), n + res.n);
    }
    else if parse_keyword(s, i, "0b").n > 0 {
        n = n + 2;

        const res = exp::parse_bin(s, i + n);
        if res.res == void: return parse_res::err("Expected binary number after '0b'", i + n, res);
        else: return parse_res::val(exp::int(to_loc(s, loc, f), res.res), n + res.n);
    }
    else if parse_keyword(s, i, "0").n > 0 {
        const res = exp::parse_oct(s, i + n);
        if res.res == void: return parse_res::err("Expected binary number after '0b'", i + n + 1, res);
        else: return parse_res::val(exp::int(to_loc(s, loc, f), res.res), n + res.n);
    }
    else {
        const res = exp::parse_dec(s, i + n);
        if res.res == void: return res;
        else: return parse_res::val(exp::int(to_loc(s, loc, f), res.res), n + res.n);
    }
}
exp::char::parse(f, s, i, prec, prev) {
    if prev != void: return parse_res::fail;

    let n = skip_white(s, i);
    const loc = n + i;

    const open = parse_keyword(s, i + n, "'");
    if open.res == void: return open;
    n = n + open.n;

    let res = 0;

    do {
        const curr = str::at(s, i + n);
        if curr == void: return parse_res::err("Unterminated char literal", i + n);
    }
    while curr != '\'' {
        const char = exp::parse_char(s, i + n);
        if char.res == void: return char;
        n = n + char.n;

        do {
            res = res * 256 + (char.res % 256);
            char.res = char.res / 256;
        }
        while char.res != 0;
    }
    n = n + 1;

    return parse_res::val(exp::int(to_loc(s, loc, f), res), n);
}

exp::string(loc, data) {
    const res = node("exp::string", loc);
    res.data = data;
    return res;
}
exp::string::parse(f, s, i, prec, prev) {
    if prev != void: return parse_res::fail;

    let n = skip_white(s, i);
    const loc = n + i;

    const open = parse_keyword(s, i + n, "\"");
    if open.res == void: return open;
    n = n + open.n;

    let res = arr();

    do {
        const curr = str::at(s, i + n);
        if curr == void: return parse_res::err("Unterminated string literal", i + n);
    }
    while curr != '"' {
        const char = exp::parse_char(s, i + n);
        if char.res == void: return char;
        n = n + char.n;

        arr::append(res, char.res);
    }
    n = n + 1;

    return parse_res::val(exp::string(to_loc(f, s, loc), res), n);
}

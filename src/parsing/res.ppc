parse_res(val, n, loc, msg) {
    const res = object();
    res.res = val;
    res.n = n;
    res.loc = loc;
    res.msg = msg;
    return res;
}

parse_res::val(val, n) {
    return parse_res(val, n, 0, void);
}
parse_res::err(err, loc, other) {
    if other == void | other.msg == void: return parse_res(void, 0, loc, err);
    else: return other;
}

const parse_res::fail = parse_res(void, 0, 0, void);

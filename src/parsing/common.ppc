skip_white(s, i) {
    let n = 0;

    do: const c = source::at(s, i + n);
    while c != void & (c == ' ' | c == '\n' | c == '\t') {
        n = n + 1;
    }

    return n;
}

parse_keyword(s, i, kw) {
    let n = skip_white(s, i);
    let j = 0;

    if kw == void {
        let res = "";

        do: const c = source::at(s, i + n);
        while char::is_upper(c) | char::is_lower(c) | char::is_num(c) | c == '_' {
            res = res + char::to_string(c);
            n = n + 1;
        }

        if str::len(res) == 0: return parse_res::fail;

        return parse_res::val(res, n);
    }
    else {
        while j < str::len(kw) {
            const a = source::at(s, i + n);
            const b = str::at(kw, j);

            if a != b: return parse_res::fail;

            n = n + 1;
            j = j + 1;
        }

        return parse_res::val(kw, n);
    }
}

parse_identifier(s, i) {
    let n = skip_white(s, i);
    const loc = i + n;

    const first = parse_keyword(s, i + n);
    if first.res == void: return first;
    n = n + first.n;

    let res = first.res;

    do: const colons = parse_keyword(s, i + n, "::");
    while (colons.res != void) {
        n = n + colons.n;
        res = res + "::";

        const word = parse_keyword(s, i + n);
        if word.res == void: return parse_res::err("Expected an identifier after '::'", i + n, word);
        n = n + word.n;

        res = res + word.res;
    }

    let underscores = 0;
    let j = 0;

    while j < str::len(res) {
        if str::at(res, j) == '_' {
            underscores = underscores + 1;
            if underscores >= 3: return parse_res::err("Too many sequential underscores", loc + j - underscores + 1);
        }
        else: underscores = 0;

        j = j + 1;
    }

    return parse_res::val(res, n);
}

node(type, loc) {
    const res = object();
    res.type = type;
    res.loc = loc;
    return res;
}

noop(loc): return node("noop", loc);

raw(loc, raw) {
    const res = node("raw", loc);
    res.data = raw;
    return res;
}
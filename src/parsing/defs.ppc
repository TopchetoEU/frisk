def::parse(f, s, i, semicolon) {
    let op;

    const entry = def::entry::parse(f, s, i, semicolon);
    if entry.msg != void | entry.res != void: return entry;
    const noop = def::noop::parse(f, s, i, semicolon);
    if noop.msg != void | noop.res != void: return noop;
    const var_decl = stm::var_decl::parse(f, s, i, semicolon);
    if var_decl.msg != void | var_decl.res != void: return var_decl;
    const func = def::func::parse(f, s, i, semicolon);
    if func.msg != void | func.res != void: return func;

    return parse_res::fail;
}

def::func(loc, name, params, body) {
    const res = node("def::func", loc);
    res.name = name;
    res.params = params;
    res.body = body;
    return res;
}
def::func::parse(f, s, i) {
    let n = skip_white(s, i);
    const loc = i + n;

    const name = parse_identifier(s, i + n);
    if name.res == void: return name;
    n = n + name.n;

    const open = parse_keyword(s, i + n, "(");
    if open.res == void: return open;
    n = n + open.n;

    const params = arr();

    const close = parse_keyword(s, i + n, ")");
    if close.res == void: do {
        const param = parse_identifier(s, i + n);
        if param.res == void: return parse_res::err("Expected a parameter name", i + n, param);
        n = n + param.n;
        arr::append(params, param.res);

        const delim = parse_keyword(s, i + n, ",");
        n = n + delim.n;
        const close = parse_keyword(s, i + n, ")");
        n = n + close.n;

        if delim.res == void & close.res == void: return parse_res::err("Expected a comma or a closing paren", i + n);
    } while(close.res == void);
    else: n = n + close.n;

    const body = stm::parse_body(f, s, i + n, true, true);
    if body.res == void: return parse_res::err("Expected a function body", i + n, body);
    n = n + body.n;

    return parse_res::val(def::func(to_loc(s, loc, f), name.res, params, body.res), n);
}

def::entry(loc, body) {
    const res = node("def::entry", loc);
    res.body = body;
    return res;
}
def::entry::parse(f, s, i) {
    let n = skip_white(s, i);
    const loc = i + n;

    const kw = parse_keyword(s, i + n, "entry");
    if kw.res == void: return kw;
    n = n + kw.n;

    const body = stm::parse_body(f, s, i + n, true, false);
    if body.res == void: return parse_res::err("Expected an entry body", i + n, body);
    n = n + body.n;

    return parse_res::val(def::entry(to_loc(s, loc, f), body), n);
}

def::noop::parse(f, s, i) {
    let n = skip_white(s, i);
    const loc = i + n;

    const op = parse_keyword(s, i + n, ";");
    if op.res == void: return op;
    n = n + op.n;

    return parse_res::val(noop(to_loc(s, loc, f)), n);
}

def::parse_file(f, s) {
    let n = 0;
    const res = arr();

    do: n = n + skip_white(s, n);
    while n < str::len(s) {
        const def = def::parse(f, s, n, true);
        if def.res == void: return parse_res::err("Expected a definition", n, def);
        n = n + def.n;
        arr::append(res, def.res);
    }

    return parse_res::val(res, n);
}
stm::parse(f, s, i, semicolon) {
    let op;

    const var_decl = stm::var_decl::parse(f, s, i, semicolon);
    if var_decl.msg != void | var_decl.res != void: return var_decl;
    const _if = stm::if::parse(f, s, i, semicolon);
    if _if.msg != void | _if.res != void: return _if;
    const loop = stm::loop::parse(f, s, i, semicolon);
    if loop.msg != void | loop.res != void: return loop;
    const return = stm::return::parse(f, s, i, semicolon);
    if return.msg != void | return.res != void: return return;

    const compound = stm::compound::parse(f, s, i, semicolon);
    if compound.msg != void | compound.res != void: return compound;
    const noop = stm::noop::parse(f, s, i, semicolon);
    if noop.msg != void | noop.res != void: return noop;
    const exp = stm::exp::parse(f, s, i, semicolon);
    if exp.msg != void | exp.res != void: return exp;

    return parse_res::fail;
}

stm::parse_body(f, s, i, semicolon, req_colon) {
    let n = skip_white(s, i);
    const loc = i + n;

    const brace = parse_keyword(s, i + n, "{");
    const colon = parse_keyword(s, i + n, ":");
    const _semicolon = parse_keyword(s, i + n, ";");

    if brace.res != void {
        const res = stm::compound::parse(f, s, i + n);
        if res.res == void: return res;
        else: return parse_res::val(res.res.body, res.n + n);
    }
    if colon.res != void {
        n = n + colon.n;
        const res = stm::parse(f, s, i + n, semicolon);
        if res.res == void: return parse_res::err("Expected a statement after colon", i + n, res);
        return parse_res::val(arr(res.res), n + res.n);
    }
    if _semicolon.res != void {
        return parse_res::val(arr(), n + _semicolon.n);
    }
    if not(req_colon) {
        const res = stm::parse(f, s, i, semicolon);
        if res.res == void: return res;
        return parse_res::val(arr(res.res), res.n);
    }

    return parse_res::fail;
}

stm::var_decl(loc, mutable, name, init) {
    const res = node("stm::var_decl", loc);
    res.mutable = mutable;
    res.name = name;
    res.init = init;
    return res;
}
stm::var_decl::parse(f, s, i, semicolon) {
    let n = skip_white(s, i);
    const loc = i + n;

    const _let = parse_keyword(s, i + n, "let");
    const _const = parse_keyword(s, i + n, "const");
    let mutable;

    if _let.res != void {
        mutable = true;
        n = n + _let.n;
    }
    else if _const.res != void {
        mutable = false;
        n = n + _const.n;
    }
    else: return parse_res::fail;

    const name = parse_identifier(s, i + n);
    if name.res == void: return parse_res::err("Expected a variable name", i + n, name);
    n = n + name.n;

    let val;

    const op = parse_keyword(s, i + n, "=");
    if op.res == void {
        if not(mutable): return parse_res::err("Expected an initializer for constant", i + n, name);
    }
    else {
        n = n + op.n;

        const exp = exp::parse(f, s, i + n);
        if exp.res == void: return parse_res::err("Expected an expression", n + i, exp);
        n = n + exp.n;
        val = exp.res;
    }

    if semicolon {
        const op = parse_keyword(s, i + n, ";");
        if op.res == void: return parse_res::err("Expected a semicolon", n + i, op);
        n = n + op.n;
    }

    return parse_res::val(stm::var_decl(to_loc(s, loc, f), mutable, name.res, val), n);
}

stm::exp::parse(f, s, i, semicolon) {
    let n = skip_white(s, i);
    const loc = i + n;


    const exp = exp::parse(f, s, i + n);
    if exp.res == void: return exp;
    n = n + exp.n;

    if semicolon {
        const op = parse_keyword(s, i + n, ";");
        if op.res == void: return parse_res::err("Expected a semicolon", n + i, op);
        n = n + op.n;
    }

    return parse_res::val(exp.res, n);
}

stm::compound(loc, body) {
    const res = node("stm::compound", loc);
    res.body = body;
    return res;
}
stm::compound::parse(f, s, i) {
    let n = skip_white(s, i);
    const loc = i + n;
    const body = arr();

    const open = parse_keyword(s, i + n, "{");
    if open.res == void: return open;
    n = n + open.n;

    const close = parse_keyword(s, i + n, "}");
    n = n + close.n;
    if close.res == void: do {
        const stm = stm::parse(f, s, i + n, true);
        if stm.res == void: return parse_res::err("Expected a statement", i + n, stm);
        n = n + stm.n;
        arr::append(body, stm.res);

        const close = parse_keyword(s, i + n, "}");
        n = n + close.n;
    }
    while close.res == void;

    return parse_res::val(stm::compound(to_loc(s, loc, f), body), n);
}

stm::noop::parse(f, s, i) {
    let n = skip_white(s, i);
    const loc = i + n;

    const op = parse_keyword(s, i + n, ";");
    if op.res == void: return op;
    n = n + op.n;

    return parse_res::val(noop(to_loc(s, loc, f)), n);
}

stm::if(loc, cond, if_body, else_body) {
    const res = node("stm::if", loc);
    res.cond = cond;
    res.if_body = if_body;
    res.else_body = else_body;
    return res;
}
stm::if::parse(f, s, i) {
    let n = skip_white(s, i);
    const loc = i + n;

    let kw = parse_keyword(s, i + n, "if");
    if kw.res == void: return kw;
    n = n + kw.n;

    const cond = exp::parse(f, s, i + n);
    if cond.res == void: return parse_res::err("Expected an if condition", i + n, cond);
    n = n + cond.n;

    const if_body = stm::parse_body(f, s, i + n, true, true);
    if if_body.res == void: return parse_res::err("Expected an if body", i + n, if_body);
    n = n + if_body.n;

    kw = parse_keyword(s, i + n, "else");
    if kw.res == void: return parse_res::val(stm::if(to_loc(s, loc, f), cond, if_body.res, arr()), n);
    n = n + kw.n;

    const else_body = stm::parse_body(f, s, i + n, true, false);
    if else_body.res == void: return parse_res::err("Expected an else body", i + n, else_body);
    n = n + else_body.n;

    return parse_res::val(stm::if(to_loc(s, loc, f), cond, if_body.res, else_body.res), n);
}

stm::loop(loc, cond, pre_body, post_body) {
    const res = node("stm::loop", loc);
    res.cond = cond;
    res.pre_body = pre_body;
    res.post_body = post_body;
    return res;
}
stm::loop::parse(f, s, i) {
    let n = skip_white(s, i);
    const loc = i + n;

    let do_body;
    let while_body;
    let cond;
    let kw;

    kw = parse_keyword(s, i + n, "do");
    if kw.res != void {
        n = n + kw.n;

        do_body = stm::parse_body(f, s, i + n, true, false);
        if do_body.res == void: return parse_res::err("Expected a do body", i + n, do_body);
        n = n + do_body.n;
    }

    kw = parse_keyword(s, i + n, "while");
    if kw.res != void {
        n = n + kw.n;

        cond = exp::parse(f, s, i + n);
        if cond.res == void: return parse_res::err("Expected a while condition", i + n, cond);
        n = n + cond.n;

        while_body = stm::parse_body(f, s, i + n, true, true);
        if while_body.res == void: return parse_res::err("Expected a while body", i + n, while_body);
        n = n + while_body.n;
    }

    if do_body == void & while_body == void: return parse_res::fail;

    if do_body == void: do_body = parse_res::val(arr(), 0);
    if while_body == void: while_body = parse_res::val(arr(), 0);
    if cond == void: cond = parse_res::val(void, 0);

    return parse_res::val(stm::loop(to_loc(s, loc, f), cond.res, do_body.res, while_body.res), n);
}

stm::return(loc, val) {
    const res = node("stm::return", loc);
    res.val = val;
    return res;
}
stm::return::parse(f, s, i, semicolon) {
    let n = skip_white(s, i);
    const loc = i + n;

    const kw = parse_keyword(s, i + n, "return");
    if kw.res == void: return kw;
    n = n + kw.n;

    const val = exp::parse(f, s, i + n);
    if val.msg != void: return val;
    n = n + val.n;

    if semicolon {
        const op = parse_keyword(s, i + n, ";");
        if op.res == void: return parse_res::err("Expected a semicolon", n + i, op);
        n = n + op.n;
    }

    return parse_res::val(stm::return(to_loc(s, loc, f), val.res), n);
}


not(a): asm "return !$$a";
and(a, b): asm "return $$a & $$b";
or(a, b): asm "return $$a | $$b";
xor(a, b): asm "return $$a ^ $$b";

rand(min, max): asm "return BigInt(Math.floor(Math.random() * Number($$max - $$min))) + $$min";
print(): asm "console.log.apply(console, arguments)";

const std::in = asm "Deno.stdin";
const std::out = asm "Deno.stdout";
const void = asm "undefined";
const true = asm "true";
const false = asm "false";

object(): asm "return {}";


arr(): asm "return Array.apply(undefined, arguments)";
arr::at(arr, i): asm "return $$arr[Number($$i)]";
arr::len(arr): asm "return BigInt($$arr.length)";
arr::append(arr, el): asm "return $$arr.push($$el)";

str::at(str, i): asm "
    const res = $$str[Number($$i)];
    if (res == null) return $$void;
    else return BigInt(res.charCodeAt());
";
str::len(str): asm "return BigInt($$str.length)";
str::cat(): asm "return [...arguments].flat().join('')";

char::is_upper(char): return char >= 'A' & char <= 'Z';
char::is_lower(char): return char >= 'a' & char <= 'z';
char::is_num(char): return char >= '0' & char <= '9';
char::is_hex(char): return char::is_num(char) | (char >= 'A' & char <= 'F') | (char >= 'a' & char <= 'z');
char::to_string(char): return asm "String.fromCharCode(Number($$char))";

std::read_all(file): asm "return new TextDecoder().decode(Deno.readFileSync($$file))";
not(a): asm::js "return !$$a";

print(): asm::js "console.log.apply(console, arguments)";
eprint(): asm::js "console.error.apply(console, arguments)";

const void = asm::js "undefined";
const true = asm::js "true";
const false = asm::js "false";

object(): asm::js "return {}";

arr(): asm::js "return []";
arr::at(arr, i): asm::js "return $$arr[Number($$i)]";
arr::len(self): asm::js "return BigInt($$self.length)";
arr::append(self, el): asm::js "
    $$self.push($$el);
    return $$self;
";
arr::append_all(self, arr): asm::js "
    $$self.push(...$$arr);
    return $$self;
";

str::at(str, i): asm::js "
    const res = $$str[Number($$i)];
    if (res == null) return $$void;
    else return BigInt(res.charCodeAt());
";
str::len(str): asm::js "return BigInt($$str.length)";

char::is_upper(char): return char >= 'A' & char <= 'Z';
char::is_lower(char): return char >= 'a' & char <= 'z';
char::is_num(char): return char >= '0' & char <= '9';
char::is_hex(char): return char::is_num(char) | (char >= 'A' & char <= 'F') | (char >= 'a' & char <= 'z');
char::to_string(char): return asm::js "String.fromCharCode(Number($$char))";

std::read_all(file): asm::js "return require('fs').readFileSync($$file).toString()";
std::time_us(): asm::js "return performance.now()";
stm::transform(element) {
    const var_decl = stm::var_decl::transform(element);
    if var_decl != void: return var_decl;

    const _if = stm::if::transform(element);
    if _if != void: return _if;

    const loop = stm::loop::transform(element);
    if loop != void: return loop;

    const return = stm::return::transform(element);
    if return != void: return return;

    const compound = stm::compound::transform(element);
    if compound != void: return compound;

    return void;
}

stm::var_decl::transform(element) {
    if element.type != "stm::var_decl": return void;

    let res;

    if element.mutable: res = "let";
    else: res = "const";

    res = res + " $$" + transform_identifier(element.name);

    if element.init != void: res = res + " = " + transform(element.init);
    return res;
}

stm::compound::transform(element) {
    if element.type != "stm::compound": return void;
    return "{" + transform_body(element.body) + "}";
}

stm::if::transform(element) {
    if element.type != "stm::if": return void;
    return
        "if(" + transform(element.cond) + "){" +
        transform_body(element.if_body) + "}" +
        "else{" + transform_body(element.else_body) + "}";
}

stm::loop::transform(element) {
    if element.type != "stm::loop": return void;

    if element.cond == void: return
        "for(;;){" +
        transform_body(element.pre_body) +
        transform_body(element.post_body) + "}";
    else: return
        "for(;;){" +
        transform_body(element.pre_body) +
        "if(!" + transform(element.cond) + ")break;" +
        transform_body(element.post_body) + "}";
}

stm::return::transform(element) {
    if element.type != "stm::return": return void;

    if element.val == void: return "return";
    else: return "return " + transform(element.val);
}

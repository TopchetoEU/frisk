exp::transform(element) {
    const asm = raw::transform(element);
    if asm != void: return asm;

    const str = exp::string::transform(element);
    if str != void: return str;

    const int = exp::int::transform(element);
    if int != void: return int;

    const pre_op = exp::pre_op::transform(element);
    if pre_op != void: return pre_op;

    const var = exp::var::transform(element);
    if var != void: return var;

    const call = exp::call::transform(element);
    if call != void: return call;

    const member = exp::member::transform(element);
    if member != void: return member;

    const op = exp::bin_op::transform(element);
    if op != void: return op;

    const assign = exp::assign::transform(element);
    if assign != void: return assign;

    return void;
}

exp::var::transform(element) {
    if element.type != "exp::var": return void;

    return "($$" + transform_identifier(element.name) + ")";
}

exp::call::transform(element) {
    if element.type != "exp::call": return void;

    let res = transform(element.obj) + "(";

    let i = 0;
    while i < arr::len(element.args) {
        res = res + transform(arr::at(element.args, i)) + ",";
        i = i + 1;
    }

    return res + ")";
}

exp::member::transform(element) {
    if element.type != "exp::member": return void;
    return transform(element.obj) + "." + transform_identifier(element.name);
}

exp::assign::transform(element) {
    if element.type != "exp::assign": return void;
    return "(" + transform(element.obj) + element.op + "=" + transform(element.val) + ")";
}

exp::bin_op::transform(element) {
    if element.type != "exp::bin_op": return void;
    if element.op == "&": return "(" + transform(element.a) + "&&" + transform(element.b) + ")";
    if element.op == "|": return "(" + transform(element.a) + "||" + transform(element.b) + ")";
    return "(" + transform(element.a) + element.op + transform(element.b) + ")";
}

exp::pre_op::transform(element) {
    if element.type != "exp::pre_op": return void;
    return "(" + element.op + transform(element.val) + ")";
}

exp::int::transform(element) {
    if element.type != "exp::int": return void;
    return "(" + element.data + "n)";
}

exp::string::transform(element) {
    if element.type != "exp::string": return void;

    const alphabet = "0123456789ABCDEF";
    let res = "'";
    let i = 0;

    while i < arr::len(element.data) {
        const el = arr::at(element.data, i);
        res = res + "\\u"
            + arr::at(alphabet, el / 0x1000 % 16)
            + arr::at(alphabet, el / 0x100 % 16)
            + arr::at(alphabet, el / 0x10 % 16)
            + arr::at(alphabet, el / 0x1 % 16);
            i = i + 1;
    }

    return res + "'";
}

source(f, s) {
    const res = object();
    res.filename = f;
    res.source = s;
    res.line_starts = arr();
    arr::append(res.line_starts, 0);

    let i = 0;
    while i < str::len(s) {
        if str::at(s, i) == '\n': arr::append(res.line_starts, i + 1);
        i = i + 1;
    }

    return res;
}

source::to_loc(s, i) {
    let left = 0;
    let right = str::len(s.source) - 1;
    let row = void;
    let start = void;

    while i != void & left <= right {
        const curr_row = (left + right) / 2;
        const curr_start = arr::at(s.line_starts, curr_row);

        if curr_start <= i {
            row = curr_row;
            start = curr_start;
            left = curr_row + 1;
        }
        else: right = curr_row - 1;
    }

    if row == void: return s.filename;

    const col = i - start;
    return s.filename + ":" + (row + 1) + ":" + (col + 1);
}
source::at(s, i) {
    return str::at(s.source, i);
}
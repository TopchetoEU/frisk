#!/bin/node

const { readdirSync, writeFileSync, readFileSync, rmSync } = require('fs');
const { spawnSync, execSync } = require("child_process");

const i = (readdirSync("bin")
    .filter(v => v.includes(".js"))
    .map(v => v.split('.')[0].substring(1))
    .map(Number)
    .sort((a, b) => b - a)[0]) ?? -1;

const srcs = [
    ...execSync("find src -name *.ppcl").toString().split('\n'),
    ...execSync("find src -name '*.ppc'").toString().split('\n'),
].filter(v => v !== '');

let res = spawnSync("bin/ppc", srcs);
if (res.error) throw res.error;
if (res.status !== 0) {
    process.stdout.write(res.stdout);
    process.stderr.write(res.stderr);
    process.exit(res.status);
}

writeFileSync("bin/ppc_tmp", `#!/bin/node\n${res.stdout.toString()}`, { mode: '755' });

res = spawnSync("bin/ppc_tmp", srcs);
if (res.error) throw res.error;
if (res.status !== 0) {
    rmSync("bin/ppc_tmp");
    process.stdout.write(res.stdout);
    process.stderr.write(res.stderr);
    process.exit(res.status);
}

writeFileSync(`bin/v${i + 1}.js`, readFileSync(`bin/ppc`));
writeFileSync("bin/ppc", `#!/bin/node\n${res.stdout.toString()}`);
rmSync("bin/ppc_tmp");